# SQLite is the local default. Set CLIMATEGUARD_DB to an absolute path if desired.
CLIMATEGUARD_DB=./data/climateguard.sqlite3

# Restrict this to the origin hosting the static frontend. Multiple origins: comma separated.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Required for kit/location registration and NASA POWER import endpoints. Generate a long random value.
ADMIN_TOKEN=replace-with-a-long-random-admin-token

# Set true to advertise NASA POWER adapter as configured. The adapter is invoked explicitly by admin.
POWER_ENABLED=false

# Browser may override this using window.CLIMATEGUARD_API_BASE before app.js loads.
CLIMATEGUARD_API_BASE=http://127.0.0.1:8000
